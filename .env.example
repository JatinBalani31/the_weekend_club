NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Get these from the Razorpay dashboard (razorpay.com) -> Settings -> API Keys.
# Test-mode keys work immediately (no KYC needed) and are enough to exercise the
# full paid-registration flow locally with fake card numbers. Live keys require
# completing KYC (PAN + bank account) so real payments can settle to your bank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard -> Settings -> Webhooks when adding
# https://<your-domain>/api/webhooks/razorpay for the payment.captured event.
# This is your own chosen value, NOT the key secret above. Without it a payment
# whose browser closed mid-checkout would never become a registration.
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# The admin's email — receives the pre-event participant list 30 min before each event.
ADMIN_EMAIL=
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_PASSWORD=
SESSION_SECRET=
# Any random string you choose — authorizes calls to /api/cron/pre-event-notify.
# Set the same value in Vercel (env var) AND in the GitHub repo's Actions secrets
# as CRON_SECRET, since GitHub Actions (not Vercel Cron) calls this endpoint —
# Vercel's Hobby plan only allows once-daily crons, too infrequent for this.
CRON_SECRET=